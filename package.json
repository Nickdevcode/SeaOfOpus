{
  "name": "sea-of-opus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D naval combat game for the browser, sloop against sloop, inspired by Sea of Thieves",
  "license": "MIT",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "check:all": "npm run check && npm -w server run check",
    "dev:server": "npm -w server run dev",
    "test:server": "node tests/roomServer.mjs",
    "deploy:server": "npm -w server run deploy",
    "tail:server": "npm -w server run tail"
  },
  "dependencies": {
    "postprocessing": "^6.39.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
