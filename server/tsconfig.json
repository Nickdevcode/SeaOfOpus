{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",

    // No `DOM`, and that is the whole point of this file existing.
    //
    // The Workers runtime declares `WebSocket`, `Response` and `fetch` with shapes of
    // its own, different from the browser's. With both libraries loaded together the
    // names collide and the compiler complains about things that have nothing to do
    // with the code as written. That is why the server has a tsconfig of its own
    // instead of entering the game's `include`.
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true
  },
  // The protocol is shared with the game: one format, one definition.
  "include": ["src", "../shared"]
}
