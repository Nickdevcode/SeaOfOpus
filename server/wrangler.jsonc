{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sea-of-opus-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  // ⚠️ A **fixed** port, and **off wrangler's default 8787**. The two things for
  // different reasons, and both cost a debugging session.
  //
  // Fixed, because without it `wrangler dev` comes up on 8788 when 8787 is taken and
  // says so in one log line nobody reads. The game keeps looking in the usual place,
  // does not find it, and the player gets a "connection dropped" with no relation at
  // all to the cause.
  //
  // Off 8787, because on Windows **two processes can listen on the same port** when
  // the first one binds with `SO_REUSEADDR` — which is `python -m http.server`'s
  // default. In that case wrangler comes up announcing success, and the connections
  // go to the other process. There is no error to detect, on either side: just a room
  // server answering with directory-listing HTML.
  //
  // 8930 is not sacred — it is just unlikely. Change it here, change it in
  // `.env.development`.
  "dev": { "port": 8930 },

  "durable_objects": {
    "bindings": [
      { "name": "DUEL_ROOM", "class_name": "DuelRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },

  // ⚠️ `new_sqlite_classes`, and **not** `new_classes`.
  //
  // Durable Objects only exist on the free plan with SQLite storage. With
  // `new_classes` the deploy fails saying "Durable Objects requires a paid plan" — a
  // message that sends you looking in the wrong place, because the problem is not the
  // plan, it is the kind of migration.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DuelRoom", "Matchmaker"] }
  ],

  // Where the game is allowed to connect from. Without this list, any page on the
  // internet opens rooms on this Worker and burns the request quota that is yours.
  //
  // ⚠️ **An origin is `scheme://host[:port]`, and nothing else** — no trailing slash,
  // no path. `https://sopgame.vercel.app/` with the slash does **not** match what the
  // browser sends, and the effect is a silent refusal that looks like a network
  // problem. It is the easiest string comparison in this project to get wrong.
  //
  // The first three are local development (`vite dev` and `vite preview`); the last
  // one is the published site.
  //
  // Vercel's preview URLs (`sopgame-git-<branch>-….vercel.app`) are deliberately not
  // here: they change with every branch and the string cannot be predicted. Anyone
  // who needs to test a preview with networking adds that deploy's origin and
  // publishes again.
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,https://sopgame.vercel.app"
  },

  "observability": { "enabled": true }
}
