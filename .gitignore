# Dependencies and build
node_modules/
dist/
# Wrangler's local state: the Durable Object's database, cache and the dev
# session's credentials. Regenerable, and none of it belongs to the project.
.wrangler/

# Inspection captures: generated by the dev bench and not worth versioning.
screenshots/
.playwright-mcp/

# Local tooling
.impeccable/
**/.impeccable/
*.local
# The agent's own instructions: they describe how I work, not how the game works,
# so they follow the machine and not the repository.
.claude/

# Byproducts of the character bench: the Blender scripts' bytecode and the backup
# Blender itself writes on save. Both regenerable.
__pycache__/
*.py[cod]
*.blend1

# Secrets — they never go in, and that is why the line exists even with no file today.
.env
.env.*
# Except the development one, which only points at the room server on localhost.
# Unversioned, whoever clones the project opens it with online mode greyed out and no
# clue why — and the file has nothing in it that is not already in the README.
!.env.development

# Operating system
Thumbs.db
.DS_Store
